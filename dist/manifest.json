{
  "name": "自动思维导图",
  "description": "自动使用视频字幕并生成思维导图",
  "version": "1.0.429.2003",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://www.youtube.com/*",
    "https://api.bilibili.com/*",
    "https://api.xiaomimimo.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-81d493c4.js"
      ],
      "matches": [
        "https://*.bilibili.com/*",
        "https://www.youtube.com/*"
      ],
      "run_at": "document_idle",
      "css": [
        "assets/index-d7cf2d19.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "resources": [
        "src/content/youtubeInterceptor.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://*.bilibili.com/*",
        "https://www.youtube.com/*"
      ],
      "resources": [
        "assets/storageService-987c722d.js",
        "assets/client-a68773c9.js",
        "assets/index.ts-cd0e93c2.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "点击暂停/恢复自动思维导图",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
